# Never commit a populated .env file. Production runs with a dedicated ECS RAM role.
NODE_ENV=production
HOST=127.0.0.1
PORT=31061
DATABASE_URL=postgresql://wevault_app:CHANGE_ME@rds-private-host:5432/wevault_staging?sslmode=require
# Keep true for RDS/remote PostgreSQL. Set false only for an isolated local database.
DATABASE_SSL=true
# Used only by `npm run migrate`; keep this higher-privilege RDS account out of PM2.
MIGRATION_DATABASE_URL=postgresql://wevault_migrator:CHANGE_ME@rds-private-host:5432/wevault_staging?sslmode=require
JWT_SECRET=generate-at-least-32-random-bytes
REFRESH_TOKEN_PEPPER=generate-a-separate-at-least-32-random-bytes
INITIAL_INVITE_ADMIN_SECRET=generate-a-separate-at-least-32-random-bytes
API_BASE_URL=https://api.wevault.online
# The native macOS client does not require CORS. Add only an explicitly
# controlled web origin if one is introduced later.
ALLOWED_ORIGINS=https://app.wevault.online
MAIL_HOST=smtpdm.aliyun.com
MAIL_PORT=465
MAIL_USER=approved-sender@example.com
MAIL_PASSWORD=direct-mail-smtp-password
MAIL_FROM=WeVault Beta <approved-sender@example.com>
OSS_BUCKET=wevault-staging-private
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ECS_RAM_ROLE_NAME=wevault-api-staging
OSS_UPLOAD_ROLE_ARN=acs:ram::123456789012:role/wevault-oss-upload-staging
OSS_DOWNLOAD_ROLE_ARN=acs:ram::123456789012:role/wevault-oss-download-staging
# Select one managed provider per staging deployment. COS secrets remain on
# the server and are used only to obtain 15-minute role credentials.
MANAGED_CLOUD_PROVIDER=aliyun-oss
COS_SECRET_ID=
COS_SECRET_KEY=
COS_ROLE_ARN=
COS_BUCKET=
COS_REGION=
COS_ENDPOINT=
# Exact COS resource prefix, for example qcs::cos:ap-shanghai:uid/123:bucket/wevault-123
COS_RESOURCE_PREFIX=
